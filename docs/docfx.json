{
  "metadata": [{
    "src": [{ "src": "..", "files": ["UniversalRobotsClient.NET/UniversalRobotsClient.NET.csproj"] }],
    "dest": "api",
    "properties": { "Configuration": "Release" },
    "disableGitFeatures": true
  }],
  "build": {
    "content": [{ "files": ["*.md", "toc.yml", "api/**.yml"] }],
    "dest": "_site",
    "template": ["default", "modern"],
    "globalMetadata": {
      "_appName": "UniversalRobotsClient.NET",
      "_appTitle": "UniversalRobotsClient.NET API",
      "_enableSearch": true,
      "_disableContribution": true
    }
  }
}